# Ollama is configured on the server only. Keep secrets out of NEXT_PUBLIC_* variables.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional for a hosted deployment using the Ollama Cloud API. Keep this server-only.
OLLAMA_API_KEY=

# Optional real image generation provider. This is server-only; never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Supabase project settings. Copy this file to .env.local and fill these values.
# Use the project's URL and publishable key. Never use a service_role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public URL assigned by the hosting provider, e.g. https://study-ai-example.vercel.app
NEXT_PUBLIC_SITE_URL=
